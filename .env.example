# The site reads frontend/.env.local locally and Vercel's environment variables in production.
# Never commit real values.

# Supabase (public: safe in the browser). Never put the sb_secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: lets the site's /api routes count usage limits (Supabase → Settings → API Keys → secret key).
SUPABASE_SECRET_KEY=

# Server only: AI rewrite, Humanize and Deep Scan.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional: address used in the sitemap and search-engine links. Defaults to https://www.originlens.bond.
NEXT_PUBLIC_SITE_URL=https://www.originlens.bond

# Email (Resend). The site code does not read these: Supabase sends sign-up codes through Resend SMTP
# (Auth → SMTP settings), and the welcome email reads the key from Supabase Vault ("resend_api_key").
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=OriginLens <no-reply@originlens.bond>
