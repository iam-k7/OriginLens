# Copy to .env and fill in. Never commit .env.
ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Supabase Postgres connection string (Settings > Database). docker-compose overrides this locally.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/originlens
REDIS_URL=redis://localhost:6379/0

# Supabase Auth: the API verifies Supabase access tokens.
# Set SUPABASE_URL (JWKS, asymmetric keys) or SUPABASE_JWT_SECRET (legacy HS256).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM providers: OpenRouter primary, Groq fallback. Leave both empty to disable rewrite/deep scan.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Limits (JSON). Daily per user (or per IP when anonymous).
RATE_LIMIT_PER_MINUTE=60
# QUOTAS={"anonymous":{"text":5,"llm":2},"free":{"text":20,"llm":10},"pro":{"text":300,"llm":150}}
MAX_UPLOAD_BYTES=15728640
# Number of reverse proxies in front of the API whose X-Forwarded-For you trust (0 = none).
TRUSTED_PROXY_COUNT=0

PRO_PRICE_USD=6
USD_INR_FALLBACK_RATE=84
FX_API_URL=https://open.er-api.com/v6/latest/USD
