# Copy to .env and fill in. Never commit .env.
ENV=development
LOG_LEVEL=INFO
# Add your live site in production, e.g. ["https://www.originlens.bond"].
CORS_ORIGINS=["http://localhost:3000"]

# Supabase Postgres connection string (Settings > Database). docker-compose overrides this locally.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/originlens
REDIS_URL=redis://localhost:6379/0

# Supabase Auth: the API verifies Supabase access tokens.
# Set SUPABASE_URL (JWKS, asymmetric keys) or SUPABASE_JWT_SECRET (legacy HS256).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWT_SECRET=

# Frontend (Vercel). The publishable/anon key is public by design; never put the sb_secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
# Address used in the sitemap and search-engine links. Defaults to https://www.originlens.bond.
NEXT_PUBLIC_SITE_URL=https://www.originlens.bond

# Email (Resend). The app code does not read these: Supabase sends the sign-up codes through
# Resend SMTP (Auth > SMTP settings), and the welcome email reads the key from Supabase Vault
# (secret "resend_api_key"). Keep them here as the reference for those two places.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=OriginLens <no-reply@originlens.bond>
FRONTEND_URL=https://www.originlens.bond

# LLM providers, tried in order: NVIDIA, OpenRouter, Groq. Leave all empty to disable rewrite/deep scan.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Limits. Images have no daily limit; text and LLM are daily per user (or per IP when anonymous).
RATE_LIMIT_PER_MINUTE=60
# QUOTAS={"anonymous":{"text":5,"llm":2},"free":{"text":20,"llm":10},"pro":{"text":300,"llm":150}}
MAX_UPLOAD_BYTES=15728640
# Number of reverse proxies in front of the API whose X-Forwarded-For you trust (0 = none).
TRUSTED_PROXY_COUNT=0

# Only used by the API's /pricing endpoint, which the site no longer shows.
PRO_PRICE_USD=6
USD_INR_FALLBACK_RATE=84
FX_API_URL=https://open.er-api.com/v6/latest/USD
