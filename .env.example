# ─────────────────────────────────────────────────────────────────────────
# OriginLens — Environment Variables (example)
# Copy to .env and fill in real values locally. NEVER commit a real .env.
# ─────────────────────────────────────────────────────────────────────────

# ─── App ────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | test | production
APP_NAME=OriginLens
APP_DEBUG=true                      # set to false in production
APP_LOG_LEVEL=INFO
APP_VERSION=0.1.0

# ─── Backend ───────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# ─── Frontend ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200

# ─── Database (Postgres) ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://originlens:originlens@localhost:5432/originlens
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# ─── Cache / Rate limit (Redis) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth / JWT ────────────────────────────────────────────────────────
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900          # 15 minutes
JWT_REFRESH_TTL_SECONDS=2592000     # 30 days

# ─── LLM Providers ─────────────────────────────────────────────────────
# Primary
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30

# Fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30

# Provider router
LLM_PRIMARY=openrouter              # openrouter | groq
LLM_FALLBACK=groq
LLM_MAX_ATTEMPTS=2
LLM_CIRCUIT_BREAKER_WINDOW_SECONDS=60

# ─── Rate limiting / quotas ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_PREFIX=originlens:rl

# Free-tier monthly limits
QUOTA_FREE_IMAGE_ANALYSIS=10
QUOTA_FREE_METADATA_SANITIZATION=5
QUOTA_FREE_TEXT_ANALYSIS=3
QUOTA_FREE_TEXT_DEEP_SCAN=1
QUOTA_FREE_TEXT_REWRITE=3

# Pro-tier monthly limits (soft caps, not literally "unlimited")
QUOTA_PRO_IMAGE_ANALYSIS=10000
QUOTA_PRO_METADATA_SANITIZATION=10000
QUOTA_PRO_TEXT_ANALYSIS=10000
QUOTA_PRO_TEXT_DEEP_SCAN=50
QUOTA_PRO_TEXT_REWRITE=10000

# ─── Image upload limits ───────────────────────────────────────────────
MAX_UPLOAD_BYTES=20971520           # 20 MiB
MAX_IMAGE_PIXELS=200000000          # 200 megapixels; guard against decompression bombs
ALLOW_SVG=false                     # SVG can carry XSS; keep off by default

# ─── Currency ──────────────────────────────────────────────────────────
PRICING_BASE_CURRENCY=USD
PRICING_PRO_USD=6
PRICING_PRO_INR=499
FX_USD_TO_INR_FALLBACK=83.0         # approximate; update on deploy
FX_LAST_UPDATED=                     # human-readable; optional

# ─── Security / CORS ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200
SECURE_COOKIES=false                # true in production
TRUSTED_HOSTS=localhost,127.0.0.1

# ─── Observability ─────────────────────────────────────────────────────
ENABLE_REQUEST_LOGGING=true
LOG_REQUEST_BODY=false              # never log file/text bodies
LOG_PROVIDER_USAGE=true
