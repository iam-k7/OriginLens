{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "redis-dev",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "python", "-c", "from fakeredis import TcpFakeServer; s=TcpFakeServer(('127.0.0.1',6379), server_type='redis'); s.serve_forever()"],
      "port": 6379
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "--env-file", "../.env.dev", "uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    }
  ]
}
